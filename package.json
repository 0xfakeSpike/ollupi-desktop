{
  "name": "ollupi-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm sidecar:build && pnpm --filter @ollupi/desktop dev",
    "build": "pnpm sidecar:build && pnpm --filter @ollupi/desktop build",
    "sidecar:build": "cd sidecar && go build -o ../apps/desktop/resources/bin/ollupid ./cmd/ollupid",
    "sidecar:test": "cd sidecar && go vet ./... && go test ./...",
    "protocol:generate": "cd sidecar && go run ./cmd/protogen -out ../packages/protocol/src/generated.ts",
    "protocol:check": "cd sidecar && go run ./cmd/protogen -check -out ../packages/protocol/src/generated.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm sidecar:test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
