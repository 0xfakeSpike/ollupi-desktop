{
  "name": "ollupi-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm sidecar:build && pnpm --filter @ollupi/desktop dev",
    "build": "pnpm sidecar:build && pnpm --filter @ollupi/desktop build",
    "package": "pnpm sidecar:release && pnpm --filter @ollupi/desktop package",
    "release": "pnpm sidecar:release && pnpm --filter @ollupi/desktop release",
    "sidecar:build": "cd sidecar && go build -tags sqlite_fts5 -o ../apps/desktop/resources/bin/ollupid ./cmd/ollupid",
    "sidecar:release": "cd sidecar && GOWORK=off CGO_ENABLED=1 MACOSX_DEPLOYMENT_TARGET=12.0 GOARCH=arm64 CC='clang -arch arm64' go build -tags sqlite_fts5 -trimpath -ldflags=-s -o ../apps/desktop/resources/bin/arm64/ollupid ./cmd/ollupid",
    "sidecar:test": "cd sidecar && go vet -tags sqlite_fts5 ./... && go test -tags sqlite_fts5 ./...",
    "protocol:generate": "pnpm --filter @ollupi/protocol generate",
    "protocol:check": "pnpm --filter @ollupi/protocol check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm sidecar:test",
    "config:generate": "pnpm --filter @ollupi/desktop config:generate",
    "config:check": "pnpm --filter @ollupi/desktop config:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
