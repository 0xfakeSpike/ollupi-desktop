{
  "name": "@ollupi/desktop",
  "productName": "Ollupi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --dir",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "config:generate": "node scripts/generate-config.mjs",
    "config:check": "node scripts/generate-config.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@ollupi/client": "workspace:*",
    "@ollupi/core": "workspace:*",
    "@ollupi/protocol": "workspace:*",
    "@ollupi/ui": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
