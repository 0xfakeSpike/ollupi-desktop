{
  "name": "@ollupi/desktop",
  "productName": "Ollupi",
  "version": "0.2.0",
  "description": "The desktop app for ollupi",
  "author": "0xfakeSpike",
  "license": "MIT",
  "homepage": "https://github.com/0xfakeSpike/ollupi-desktop",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac --dir --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "config:generate": "node scripts/generate-config.mjs",
    "config:check": "node scripts/generate-config.mjs --check",
    "test": "vitest run",
    "release": "electron-vite build && electron-builder --mac --arm64 --x64 --publish never",
    "postinstall": "node scripts/node-pty-helper.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ollupi/client": "workspace:*",
    "@ollupi/core": "workspace:*",
    "@ollupi/protocol": "workspace:*",
    "@ollupi/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "beautiful-mermaid": "^1.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
